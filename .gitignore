# Rust / cargo
/target/
/target-*/
**/target/
Cargo.lock.bak

# jev-opt artifacts
/artifacts/
/pgo/
/remarks/
/reports/
*.profraw
*.profdata
jev-plan*.json
sites*.json
apply-report-*.json
run-manifest.json

# LLVM plugin build
/plugin/build/
*.so
*.o

# local
.env
*.log

# working notes (not tracked)
/work/

# zopfli generated workloads and their compressor output (regenerable:
# targets/zopfli/workloads/gen.py, fixed seeds)
/targets/zopfli/workloads/*.dat
/targets/zopfli/workloads/*.gz

# jaq generated workloads (regenerable: targets/jaq/workloads/gen.py, fixed seeds)
/targets/jaq/workloads/*.json

# jaq PGO candidate pool: pool.json is a result and is tracked; the 1 MB
# filter file bench.sh's `defs` benchmark generates is regenerable
# (scripts/jaq_pool_extract.py extract)
/targets/jaq/pool/gen/

# python bytecode
__pycache__/

# LLVM headers the pass plugins compile against (scripts/fetch_llvm_headers.sh)
/third_party/
