# Copy to .env and fill in. .env is git-ignored.

# Vercel AI Gateway key (the "gateway" route, the default; Hobby plan's free
# tier is enough). Used when [jev] endpoint / JEV_ENDPOINT / --jev-endpoint
# resolve to "gateway" (decision 111).
AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# TypeSafe's own API key (the "direct" route: api.typesafe.ai). No free
# tier; a 5-round search costs roughly $0.03 (~0.6M input tokens at
# $0.042 / 1M). Used when the route resolves to "direct" (decision 111).
TYPESAFE_API_KEY=your_typesafe_api_key

# Which route to use: "gateway", "direct", or unset/"auto" (the default:
# pick by which of the two keys above is present; if both are, "gateway").
# --jev-endpoint overrides this for one run (decision 111).
JEV_ENDPOINT=auto
